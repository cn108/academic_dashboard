# Production configuration template for one school / one server.
# Copy to .env on the server, fill every value, then: chmod 600 .env
# Never commit the filled file. See DEPLOYMENT.md for the full runbook.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=False

# Generate with: openssl rand -base64 48
SECRET_KEY=replace-with-a-long-random-production-secret

# Bare hostnames, comma-separated. Keep 127.0.0.1 for the container healthcheck.
DJANGO_ALLOWED_HOSTS=school.example.edu.ng,127.0.0.1,localhost
FRONTEND_URL=https://school.example.edu.ng
CSRF_TRUSTED_ORIGINS=https://school.example.edu.ng

# ---------------------------------------------------------------------------
# PostgreSQL / Docker Compose
# ---------------------------------------------------------------------------
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
# Generate with: openssl rand -hex 24 (hex avoids URL-encoding problems).
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Caddy's certificate hostname. Must match the FRONTEND_URL hostname.
DOMAIN=school.example.edu.ng
NGINX_PORT=8080

# The production overlay forces SECURE_SSL_REDIRECT=True; keep it explicit too.
SECURE_SSL_REDIRECT=True
SERVE_MEDIA=True

# ---------------------------------------------------------------------------
# School defaults
# ---------------------------------------------------------------------------
AXES_ENABLED=True
DEFAULT_STUDENT_PASSWORD=replace-with-a-private-first-login-password
SCHOOL_NAME=Replace with the school name

# Optional fixed demo passwords. Do not run seed_demo on a real school.
# DEMO_TEACHER_PASSWORD=
# DEMO_PARENT_PASSWORD=

# Email: use SMTP in production if email delivery is required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@school.example.edu.ng

# ---------------------------------------------------------------------------
# Paystack (live mode only)
# ---------------------------------------------------------------------------
# Complete Paystack business activation/KYC before using live keys.
# Register https://school.example.edu.ng/api/webhooks/paystack/ in Paystack.
# Copy the live keys here; never commit the filled file.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Termii (SMS / optional WhatsApp)
# ---------------------------------------------------------------------------
# Use the approved production Sender ID, not a test sender.
TERMII_API_KEY=
TERMII_SENDER_ID=ReplaceWithApprovedSenderID
WHATSAPP_ENABLED=False
TERMII_WHATSAPP_DEVICE_ID=
TERMII_WHATSAPP_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# The backup script reads these from its own cron environment, not from .env:
# BACKUP_DIR=/var/backups/academic-dashboard
# BACKUP_RETENTION_DAYS=14