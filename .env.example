# Local development template. Copy to .env and adjust. Never commit .env.
# For a public server use .env.production.example instead.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
# Generate with: openssl rand -base64 48
SECRET_KEY=change-me-to-a-long-random-string

ALLOWED_HOSTS=localhost,127.0.0.1
# Preferred production name; DJANGO_ALLOWED_HOSTS wins when both are set.
# DJANGO_ALLOWED_HOSTS=school.example.edu.ng,127.0.0.1,localhost

# Public origin used by Paystack callbacks and appended to CSRF origins.
# Docker Compose serves the SPA on :8080; change this to :4200 for manual dev.
FRONTEND_URL=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

# Local development uses SQLite. The Docker stack overrides this with Postgres.
DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------------
# Docker Compose stack
# ---------------------------------------------------------------------------
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
# Local-only password. Use openssl rand -hex 24 for production.
POSTGRES_PASSWORD=change-me-local-postgres-password
NGINX_PORT=8080

# Production-only values are documented in .env.production.example.
# DOMAIN=school.example.edu.ng
# SECURE_SSL_REDIRECT=False
# SERVE_MEDIA=True

# ---------------------------------------------------------------------------
# School defaults
# ---------------------------------------------------------------------------
AXES_ENABLED=True
DEFAULT_STUDENT_PASSWORD=Student@1234
SCHOOL_NAME=Model Secondary School

# Optional fixed demo passwords. If omitted, seed_demo generates them and prints
# the values. Never run seed_demo against a real school database.
# DEMO_TEACHER_PASSWORD=
# DEMO_PARENT_PASSWORD=

# Email (console backend by default; configure SMTP for real delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@school.example

# ---------------------------------------------------------------------------
# Paystack (school fees)
# ---------------------------------------------------------------------------
# Create a test key at https://dashboard.paystack.com/#/settings/developers
# Secret key starts with sk_test_; never expose it to the SPA.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Public HTTPS URL Paystack calls after checkout; the webhook itself is at
# https://<your-domain>/api/webhooks/paystack/.
# PAYSTACK_WEBHOOK_SECRET is not needed: the endpoint verifies the signature
# with PAYSTACK_SECRET_KEY.

# ---------------------------------------------------------------------------
# Parent alerts (SMS / WhatsApp)
# ---------------------------------------------------------------------------
# Termii transactional SMS (Nigerian DND route). Use the Termii Sandbox for
# development; production Sender ID approval can take time.
TERMII_API_KEY=
TERMII_SENDER_ID=SchoolApp

# WhatsApp is disabled by default. Enable only after Termii/Meta approve a
# template with one {{1}} placeholder and provide the device identifier.
WHATSAPP_ENABLED=False
TERMII_WHATSAPP_DEVICE_ID=
TERMII_WHATSAPP_TEMPLATE_ID=

# Logging
LOG_LEVEL=INFO