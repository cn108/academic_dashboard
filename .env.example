# Copy to .env and adjust. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database: sqlite is the default; point at Postgres in production.
# DATABASE_URL=postgres://dashboard:dashboard@db:5432/dashboard
DATABASE_URL=sqlite:///db.sqlite3

# Login throttling
AXES_ENABLED=True

# Password given to every student a teacher imports from CSV.
# Students are forced to change it the first time they sign in.
DEFAULT_STUDENT_PASSWORD=Student@1234

# Email (console backend by default; set SMTP for real delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@school.example

# Logging
LOG_LEVEL=INFO
