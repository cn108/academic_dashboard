# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Preferred production name; DJANGO_ALLOWED_HOSTS wins when both are set.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.edu.ng

# Where the SPA is served from. Added to CSRF_TRUSTED_ORIGINS automatically.
# FRONTEND_URL=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database: sqlite is the default; point at Postgres in production.
# DATABASE_URL=postgres://dashboard:dashboard@db:5432/dashboard
DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------------
# Production stack (docker compose) — these feed docker-compose.yml
# ---------------------------------------------------------------------------
# POSTGRES_DB=dashboard
# POSTGRES_USER=dashboard
# POSTGRES_PASSWORD=change-me-too
# NGINX_PORT=8080
# The compose file builds DJANGO_ALLOWED_HOSTS, DATABASE_URL and
# CSRF_TRUSTED_ORIGINS from the values above, and defaults FRONTEND_URL to
# http://localhost:8080. Set SECURE_SSL_REDIRECT=True only behind HTTPS:
# SECURE_SSL_REDIRECT=False
# SERVE_MEDIA=True             # let Django deliver /media/ behind Nginx

# Login throttling
AXES_ENABLED=True

# Password given to every student a teacher imports from CSV.
# Students are forced to change it the first time they sign in.
DEFAULT_STUDENT_PASSWORD=Student@1234

# Printed at the top of report cards.
SCHOOL_NAME=Model Secondary School

# Email (console backend by default; set SMTP for real delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@school.example

# ---------------------------------------------------------------------------
# Paystack (school fees)
# ---------------------------------------------------------------------------
# Create a test key at https://dashboard.paystack.com/#/settings/developers
# Secret key starts with sk_test_; never expose it to the SPA.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Public HTTPS URL Paystack calls back after checkout; the webhook itself is at
# https://<your-domain>/api/webhooks/paystack/
# PAYSTACK_WEBHOOK_SECRET is not needed: the endpoint verifies the signature
# with PAYSTACK_SECRET_KEY.

# ---------------------------------------------------------------------------
# Parent alerts (SMS / WhatsApp)
# ---------------------------------------------------------------------------
# Termii is the Nigerian SMS/WhatsApp gateway. Until a key is set the mock
# provider logs every message to the console and marks it sent.
TERMII_API_KEY=
TERMII_SENDER_ID=SchoolPortal
WHATSAPP_ENABLED=False

# Logging
LOG_LEVEL=INFO
